@{
    ViewBag.Title = "Registrar Empresas";
}

<section class="container-fluid px-0">
    <h2 class="mb-3">Registrar Empresa</h2>
    <div class="utn-card">
        <div class="utn-card-body">
            <form onsubmit="createE(); return false;">
                <div class="form-row">
                    <div class="form-group col-md-5">
                        <label for="name">Empresa</label>
                        <input type="text" class="form-control" id="name" placeholder="Nombre de la Empresa" required />
                    </div>
                    <div class="form-group col-md-3">
                        <label for="tel">Teléfono / WhatsApp</label>
                        <input type="tel" class="form-control" id="tel" placeholder="+506 8888-8888" />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="email">Correo electrónico</label>
                        <input type="email" class="form-control" id="email" placeholder="contacto@empresa.cr" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="contactName">Nombre de Contacto</label>
                        <input type="text" class="form-control" id="contactName" placeholder="Nombre de Contacto" required />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="direction">Dirección</label>
                        <input type="text" class="form-control" id="direction" placeholder="Provincia, cantón y señas" />
                    </div>
                    <div class="form-group col-md-4">
                        <label for="production">Sector de Producción</label>
                        <select id="production" class="form-control">
                            <option value="Agricultura" selected>Agricultura</option>
                            <option value="Apicultura y Pesca">Apicultura y Pesca</option>
                            <option value="Artísticas y Entretenimiento">Artísticas y Entretenimiento</option>
                            <option value="Actividad Inmobiliaria">Actividad Inmobiliaria</option>
                            <option value="Alimentación y Bebidas">Alimentación y Bebidas</option>
                            <option value="Banca y Finanzas">Banca y Finanzas</option>
                            <option value="Comercio Exterior">Comercio Exterior</option>
                            <option value="Comunicación">Comunicación</option>
                            <option value="Comercio">Comercio</option>
                            <option value="Construcción">Construcción</option>
                            <option value="Electrónica">Electrónica</option>
                            <option value="Enseñanza / Educación">Enseñanza / Educación</option>
                            <option value="Electricidad">Electricidad</option>
                            <option value="Fabricación Industrial">Fabricación Industrial</option>
                            <option value="Ganadería">Ganadería</option>
                            <option value="Mercadeo">Mercadeo</option>
                            <option value="Minería y Canteras">Minería y Canteras</option>
                            <option value="Manufactura">Manufactura</option>
                            <option value="Medicina, Salud y Farmacéutica">Medicina, Salud y Farmacéutica</option>
                            <option value="Hotelería">Hotelería</option>
                            <option value="Producción Madera">Producción Madera</option>
                            <option value="Producción Plástico">Producción Plástico</option>
                            <option value="Productos Químicos y de Limpieza">Productos Químicos y de Limpieza</option>
                            <option value="Silvicultura">Silvicultura</option>
                            <option value="Servicio Técnico">Servicio Técnico</option>
                            <option value="Servicio de Seguros">Servicio de Seguros</option>
                            <option value="Servicios Básicos">Servicios Básicos</option>
                            <option value="Servicios Profesionales">Servicios Profesionales</option>
                            <option value="Servicio Doméstico">Servicio Doméstico</option>
                            <option value="Turismo">Turismo</option>
                            <option value="Transportes">Transportes</option>
                            <option value="Textiles y Ropa">Textiles y Ropa</option>
                            <option value="Recreativas">Recreativas</option>
                            <option value="Reparación y Mantenimiento">Reparación y Mantenimiento</option>
                            <option value="Reciclaje">Reciclaje</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="far fa-save"></i> Guardar Empresa</button>
            </form>
        </div>
    </div>
</section>

@section scripts{
    <script type="text/javascript" src="~/Scripts/Custom/datatables.min.js"></script>
    <script src="~/Scripts/Custom/httpmethods.js"></script>
    <script src="~/Scripts/Custom/Empresas.js"></script>
}
