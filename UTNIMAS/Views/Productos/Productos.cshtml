@model List<UTNIMAS.Models.ProductosModels>
@{
    ViewBag.Title = "Productos";
    var items = Model ?? new List<UTNIMAS.Models.ProductosModels>();
}

<section class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3" style="gap:12px;">
        <div>
            <h2 class="mb-0">Catálogo de Productos</h2>
            <small style="color:var(--utn-muted);">Busca por nombre o descripción y contacta directamente a cada emprendimiento</small>
        </div>
        <div class="d-flex flex-wrap align-items-center" style="gap:10px;">
            <input id="utnCatalogSearch" type="search" class="form-control form-control-sm" style="min-width:240px;" placeholder="Buscar producto o descripción..." aria-label="Buscar producto" />
            <a class="btn btn-success btn-sm" href="/Registro/RegistroProductos"><i class="fas fa-plus"></i> Publicar producto</a>
        </div>
    </div>

    <div class="utn-grid">
        @foreach (var element in items)
        {
            <article class="utn-card" data-product-card data-search="@(element.NOMBRE_PRODUCTO + " " + element.DESCRIP_PRODUCTO)">
                <a href="#"
                   data-toggle="modal"
                   data-target="#modalIMG"
                   data-foto="@element.FOTO_PRODUCTO"
                   data-nombre="@element.NOMBRE_PRODUCTO"
                   data-desc="@element.DESCRIP_PRODUCTO"
                   data-empresa-id="@element.EMPRESA_ID"
                   data-precio="@element.ID_PRECIO"
                   onclick="openProductPreviewFromEl(this); return false;">
                    <img src="@element.FOTO_PRODUCTO" alt="@element.NOMBRE_PRODUCTO" onerror="this.src='/Content/Images/NoDisponible.jpg'" />
                </a>
                <div class="utn-card-body">
                    <h4>@element.NOMBRE_PRODUCTO</h4>
                    <p>@element.DESCRIP_PRODUCTO</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <strong>@(element.ID_PRECIO > 1 ? "₡ " + element.ID_PRECIO.ToString("N0") : "Consultar")</strong>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                data-toggle="modal"
                                data-target="#modalIMG"
                                data-foto="@element.FOTO_PRODUCTO"
                                data-nombre="@element.NOMBRE_PRODUCTO"
                                data-desc="@element.DESCRIP_PRODUCTO"
                                data-empresa-id="@element.EMPRESA_ID"
                                data-precio="@element.ID_PRECIO"
                                onclick="openProductPreviewFromEl(this)">
                            Ver y Contactar
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>

    <p id="utnCatalogEmpty" class="alert alert-info mt-3" style="display:none;">No se encontraron productos que coincidan con tu búsqueda.</p>
</section>

<div aria-hidden="true" aria-labelledby="myModalLabel" class="modal fade" id="modalIMG" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myModalLabel"><span id="NombreProducto">Producto</span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="ImgModal" style="max-width:100%; max-height:360px; border-radius:10px; object-fit:cover;" src="~/Content/Images/NoDisponible.jpg" alt="Vista previa del producto" />
                </div>
                <p><strong>Precio:</strong> <span id="PrecioModal">Consultar</span></p>
                <p id="Descripcion"></p>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <tbody>
                            <tr><th>Empresa</th><td id="NombreEmpresa">—</td><th>Sector</th><td id="Sector">—</td></tr>
                            <tr><th>Contacto</th><td id="Contacto">—</td><th>Dirección</th><td id="Direccion">—</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="utn-contact-bar">
                    <a id="btnContactoWA" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm"><i class="fab fa-whatsapp"></i> WhatsApp</a>
                    <a id="btnContactoEmail" href="#" class="btn btn-primary btn-sm"><i class="fas fa-envelope"></i> Correo</a>
                    <a id="btnContactoTel" href="#" class="btn btn-outline-secondary btn-sm"><i class="fas fa-phone"></i> Llamar</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript" src="~/Scripts/Custom/datatables.min.js"></script>
    <script src="~/Scripts/Custom/httpmethods.js"></script>
    <script src="~/Scripts/Custom/Productos.js"></script>
}
